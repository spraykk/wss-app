{
  "expo": {
    "name": "보행 개선",
    "slug": "wss-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "wssapp",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wssapp.walkingsafety",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "보행 중 사고다발구역 진입을 감지해 경고하고, 실제로 이동/보행 중인지 판단해 보행 세션을 측정하며 걸으며 스마트폰을 보는지 추정해 보행 안전 점수를 산정하기 위해 위치 정보를 사용합니다. 위치·경로는 기기 밖으로 전송하지 않습니다.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "화면이 꺼져 있거나 다른 앱을 사용하는 중에도 (1) 사고다발구역 진입을 감지해 경고하고, (2) 보행 세션을 이어가며 이동/보행 여부를 계속 확인하고, (3) 그 위에서 걸으며 스마트폰을 보는지 판단해 보행 안전 점수를 산정하기 위해 '항상' 위치 접근이 필요합니다. 위치·경로는 기기 밖으로 전송하지 않으며, 서버로는 익명 점수·날짜·기기 식별자·선택한 연령대만 전송합니다.",
        "NSMotionUsageDescription": "보행 중인지 판단해 정지 상태에서 불필요한 경고를 줄이기 위해 걸음 수·동작 센서를 사용합니다.",
        "UIBackgroundModes": [
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.wssapp.walkingsafety",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#BFE3F5"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "ACTIVITY_RECOGNITION"
      ]
    },
    "web": {},
    "plugins": [
      "expo-router",
      "expo-notifications",
      "./plugins/withAudioEnvironment"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2a684753-bd4e-453c-bda7-06287de7e7ac"
      },
      "EXPO_PUBLIC_SUPABASE_URL": "https://micrzscqiabrzpsomxut.supabase.co",
      "EXPO_PUBLIC_SUPABASE_KEY": "sb_publishable_5jHUvdgoy3ZPcioXhsDm_A_lw6GHsgT",
