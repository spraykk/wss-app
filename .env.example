# 이 파일을 복사해서 .env 로 저장한 뒤 실제 발급받은 키를 넣으세요.
# (아래 키가 없어도 앱은 실행되지만, 날씨는 항상 '맑음'으로 처리됩니다)
# 기상청 단기예보 API 키 (data.go.kr, 승인 즉시/당일 발급)
EXPO_PUBLIC_KMA_API_KEY=
# 도로교통공단 TAAS 사고다발지역 API 키 (data.go.kr, 승인까지 1~수일 소요될 수 있음)
# 앱 코드에서 직접 쓰지 않고, scripts/fetch-real-accident-zones.ts 에서 1회성으로 사용합니다.
TAAS_API_KEY=
