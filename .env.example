# 이 파일을 복사해서 .env 로 저장한 뒤 실제 발급받은 키를 넣으세요.
# (아래 키가 없어도 앱은 실행되지만, 날씨는 항상 '맑음'으로 처리됩니다)
# 기상청 단기예보 API 키 (data.go.kr, 승인 즉시/당일 발급)
EXPO_PUBLIC_KMA_API_KEY=
# 도로교통공단 TAAS 사고다발지역 API 키 (data.go.kr, 승인까지 1~수일 소요될 수 있음)
# 앱 코드에서 직접 쓰지 않고, scripts/fetch-real-accident-zones.ts 에서 1회성으로 사용합니다.
TAAS_API_KEY=

# Supabase 익명 통계 서버 (무료 BaaS). 아래 두 값이 없으면 통계 기능은 안전하게
# 비활성화되고(no-op) 앱은 로컬 기록만으로 정상 동작합니다.
# - URL: Supabase 프로젝트 URL (예: https://<project-ref>.supabase.co)
# - KEY: publishable/anon 공개키. 클라이언트 번들에 포함되어도 되는 공개키이며,
#   RLS 정책으로 익명 insert/upsert 와 통계 RPC 실행만 허용됩니다. service_role/secret
#   키는 절대 여기에 넣지 마세요(앱에 노출되면 안 됩니다).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
